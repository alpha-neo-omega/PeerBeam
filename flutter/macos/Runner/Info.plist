<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!-- The DNS-SD types we browse, declared for the local-network prompt
	     below. Must stay in step with peerbeam-discovery-mdns's SERVICE_TYPE
	     ("_peerbeam._tcp.local."); an entry omits the domain suffix. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_peerbeam._tcp</string>
	</array>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<!-- macOS 15+ gates local network access behind a prompt. This string is
	     what the prompt shows as the reason; without it the user is asked to
	     approve access with nothing said about what for. Either way a denial
	     looks exactly like a network with no peers on it, which is a separate
	     gap on the Rust side rather than something this file can fix. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>PeerBeam looks for devices on this network so you can send files to them directly.</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
