<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- P2P transfer: accept inbound + dial outbound QUIC/UDP. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Read files the user picks/drops to send, write files they receive. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Received files default to the OS Downloads folder. This grants access
	     to the user's real one; it does not by itself make the app *name* it,
	     because the sandbox also redirects $HOME to the container and that is
	     what dirs reads. peerbeam_platform::download_dir rewrites a container
	     path back to the real home for that reason — both halves are needed,
	     and neither works alone. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
